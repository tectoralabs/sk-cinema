# SK Cinema API environment. Copy to apps/api/.env and fill in real values.
# Placeholders only: never put real credentials or secrets in this file.
# Validated at startup by src/config/env.ts; the API refuses to start if anything is invalid.
#
# Generate each secret separately (they must differ):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- Runtime ---------------------------------------------------------------

# development | test | production (default: development)
NODE_ENV=development
# HTTP port, 1-65535 (default: 4000)
PORT=4000
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------

# Required: fill in; empty fails startup validation.
# Pooled connection string used by the app. Include connect_timeout=15.
DATABASE_URL=
# Required for migrations: fill in; empty means Prisma has no database to migrate.
# Direct (non-pooled) connection string used only by Prisma migrations.
DIRECT_URL=

# --- HTTP ------------------------------------------------------------------

# Public site origins: comma-separated bare origins, https only in production.
# They get CORS without credentials and never on /api/admin. Admin origins go in ADMIN_ORIGINS.
CORS_ORIGINS=http://localhost:5173
# Admin app origins: comma-separated bare origins, https only in production (the admin
# subdomain, e.g. https://admin.example.com). The only origins given credentialed CORS and
# accepted by the CSRF check on /api/admin. Never list the public site here.
# Dev: the admin Vite server (port 5174, strictPort) proxies /api, so the Origin is this.
ADMIN_ORIGINS=http://localhost:5174
# Number of reverse proxies in front of the API, 0-10 (default: 0)
TRUST_PROXY=0
# General API rate limit: window in ms and max requests per window per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Auth ------------------------------------------------------------------

# Signs access tokens. Required: fill in; empty fails startup validation.
# At least 32 characters; generate with the command at the top of this file.
JWT_ACCESS_SECRET=
# Signs CSRF tokens. Required: fill in; empty fails startup validation.
# At least 32 characters, must differ from JWT_ACCESS_SECRET; generate with the command at the top.
CSRF_SECRET=
# Access token lifetime in seconds, 60-3600 (default: 900)
ACCESS_TOKEN_TTL_SECONDS=900
# Absolute refresh token lifetime in hours, 1-720; rotation does not extend it (default: 168)
REFRESH_TOKEN_TTL_HOURS=168
# Failed logins before the account is temporarily locked, 3-20 (default: 5)
LOGIN_MAX_FAILED_ATTEMPTS=5
# Lockout duration in minutes, 1-1440 (default: 15)
LOGIN_LOCKOUT_MINUTES=15
# Login rate limit per IP: window in ms (60000-86400000, default: 900000)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Login rate limit per IP: max attempts per window (1-100, default: 10)
LOGIN_RATE_LIMIT_MAX=10

# --- Seed script only (pnpm --filter api db:seed) ----------------------------

# First SUPER_ADMIN account, created only if it does not exist yet.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
# Required: fill in; empty fails seed validation.
# 12-128 characters. Use a strong unique password and change it after first login.
SEED_SUPER_ADMIN_PASSWORD=
# Display name
SEED_SUPER_ADMIN_NAME=
# Optional true | false: sample movies and showtimes. Unset = on, except off in production.
# SEED_SAMPLE_DATA=true
